# ==========================================
# KotoGelo Mobile App - Environment Configuration
# ==========================================

# Backend API Base URL (Point to local backend or production server)
# Note: For physical Android devices / emulators use LAN IP (e.g. http://192.168.0.105:5000/api/v1) or 10.0.2.2:5000
EXPO_PUBLIC_API_BASE_URL=https://koto-gelo-backend.vercel.app/api/v1

# API Network Request Timeout (in milliseconds)
EXPO_PUBLIC_API_TIMEOUT=15000

# Application Environment Mode
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME="KotoGelo"
EXPO_PUBLIC_APP_VERSION="1.0.0"
