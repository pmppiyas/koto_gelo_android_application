{
  "expo": {
    "name": "KotoGelo - Smart Expense & Mess Tracker",
    "slug": "kotogelo",
    "version": "1.0.0",
    "description": "Smart daily personal expense tracker and mess group bill manager. Track spending, split shared bills, and settle debts in real-time.",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#2563EB",
    "scheme": "kotogelo",
    "icon": "./assets/images/logo.png",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "splash": {
      "image": "./assets/images/logo.png",
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kotogelo.app",
      "infoPlist": {
        "CFBundleDisplayName": "KotoGelo"
      }
    },
    "android": {
      "package": "com.kotogelo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "name": "KotoGelo - Smart Expense & Mess Tracker",
      "shortName": "KotoGelo",
      "description": "Track personal and mess group expenses with real-time settlement.",
      "themeColor": "#2563EB",
      "backgroundColor": "#0F172A",
      "bundler": "metro",
      "lang": "bn",
      "display": "standalone",
      "favicon": "./assets/icons/favicon.ico"
    },
    "extra": {
      "eas": {
        "projectId": "3b1a86de-99de-49e6-90dd-953ce1d6c92e"
      }
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
